# QuickHire Backend — environment template
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# App
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=mongodb://localhost:27017/job-portal

# Security
BCRYPT_SALT_ROUNDS=12

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# Demo accounts (used by `npm run seed`) — replace with your own dev credentials
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=change_me
DEMO_RECRUITER_EMAIL=recruiter@example.com
DEMO_RECRUITER_PASSWORD=change_me
DEMO_CANDIDATE_EMAIL=candidate@example.com
DEMO_CANDIDATE_PASSWORD=change_me
